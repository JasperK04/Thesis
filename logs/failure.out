import sys

def winner_across_circle(N: int) -> int:
    # Largest power of 2 <= N
    p = 1 << (N.bit_length() - 1)
    if N == p:
        return N

    l = N - p  # elves beyond the largest power of two
    half = p // 2

    if l <= half:
        return 2 * l + 1
