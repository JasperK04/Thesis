[33mimport sys

def solve(n: int) -> int:
    if n == 1:
        return 1

    # Closed-form solution for AoC 2016 Day 19 Part 2 ("across the circle")
    # Let L be the largest power of 2 <= n, and r = n - L.
    # Winner:
    #   if r == 0: n
    #   elif n <= 2*L: r
    #   else: 2*r - L
    l = 1
    while l * 2 <= n:
        l *= 2
    r = n - l

    if r == 0:
        return n
    if n <= 2 * l:
        return r
    return 2 * r - l

def main():
    data = sys.stdin.read().strip().split()
    if not data:
        return
    n = int(data[0])
    print(solve(n))

if __name__ == "__main__":
    main()
