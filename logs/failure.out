      repeatedly remove the opposite element by maintaining two halves of the circle.
    ]]></description>
    <pseudocode>
      # Simulation using two deques representing left and right halves
      function winner_across_simulation(N):
          # Initialize circle as a deque of positions 1..N
          left = deque()   # one half
          right = deque()  # other half
          # Split so that “across” is well-defined by sizes
          # (Implementation detail: keep sizes balanced)
          for i in 1..N:
              if i <= ceil(N/2):
                  left.push_back(i)
              else:
                  right.push_back(i)

          # While more than one elf remains
          while size(left) + size(right) > 1:
              # Determine across target:
              # If sizes are equal, across is the front of right (or left depending on convention).
              # Remove that target.
              if size(left) == size(right):
                  target = right.pop_front()
              else:
                  target = left.pop_front()  # depends on balancing convention

              # Rotate/move next stealer:
              # Move one step forward in the circle by rebalancing/rotating halves.
              # (Again, exact operations depend on chosen representation.)
              rebalance_and_rotate(left, right)

          # Remaining element is the winner
          if size(left) == 1:
              return left.front()
          else:
              return right.front()

      read N
      print winner_across_simulation(N)
    </pseudocode>
    <techniques><![CDATA[
