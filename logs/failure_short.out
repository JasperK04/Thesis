PACEcoding short log (AoC 2016 Day 19, Part 2) "An Elephant Named Joseph"

CODE:
import sys

def solve(n: int) -> int:
    # Largest power of 2 <= n
    p = 1 << (n.bit_length() - 1)
    m = n - p
    if m == 0:
        return n
    return 2 * m

def main():
    data = sys.stdin.read().strip().split()
    if not data:
        return
    n = int(data[0])
    print(solve(n))

if __name__ == "__main__":
    main()

