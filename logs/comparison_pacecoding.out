[33mimport sys
from dataclasses import dataclass, field
from typing import Dict, List, Optional


@dataclass
class DirNode:
    name: str
    parent: Optional["DirNode"] = None
    children_dirs: Dict[str, "DirNode"] = field(default_factory=dict)
    direct_files_sum: int = 0
    total_size: int = 0


def solve(lines: List[str]) -> int:
    root = DirNode(name="/", parent=None)
    current = root

    def get_or_create_child(parent: DirNode, child_name: str) -> DirNode:
        if child_name not in parent.children_dirs:
            parent.children_dirs[child_name] = DirNode(name=child_name, parent=parent)
        return parent.children_dirs[child_name]

    i = 0
    n = len(lines)
    while i < n:
        line = lines[i].strip()
        if not line:
            i += 1
            continue

        if line.startswith("$ cd "):
            arg = line[5:].strip()
            if arg == "/":
                current = root
            elif arg == "..":
                if current.parent is not None:
                    current = current.parent
            else:
                current = get_or_create_child(current, arg)
            i += 1
        elif line.startswith("$ ls"):
            i += 1
            while i < n and not lines[i].lstrip().startswith("$"):
                out = lines[i].strip()
                if out:
                    if out.startswith("dir "):
                        name = out[4:].strip()
                        get_or_create_child(current, name)
                    else:
                        size_str, _fname = out.split(maxsplit=1)
                        current.direct_files_sum += int(size_str)
                i += 1
        else:
            # Unexpected line; skip gracefully
            i += 1

    # Post-order DFS to compute total sizes and collect all nodes
    all_nodes: List[DirNode] = []
    stack = [(root, 0)]  # (node, state) state 0=enter, 1=exit
    while stack:
        node, state = stack.pop()
        if state == 0:
            stack.append((node, 1))
            for child in node.children_dirs.values():
                stack.append((child, 0))
        else:
            total = node.direct_files_sum
            for child in node.children_dirs.values():
                total += child.total_size
            node.total_size = total
            all_nodes.append(node)

    disk_total = 70_000_000
    required_free = 30_000_000
    used = root.total_size
    current_free = disk_total - used
    need_to_free = required_free - current_free

    # Find smallest directory that frees enough space
    best = None
    for node in all_nodes:
        if node.total_size >= need_to_free:
            if best is None or node.total_size < best:
                best = node.total_size

    # If need_to_free <= 0, best will be the smallest directory total size (including root)
    # In valid inputs, best should always be found.
    return best if best is not None else 0


def main():
    lines = sys.stdin.read().splitlines()
    ans = solve(lines)
    sys.stdout.write(str(ans) + "\n")


if __name__ == "__main__":
    main()
