MapCoder short log (AoC 2022 Day 7 part 2) "No Space Left On Device"

CODE:
import sys

def solve():
    lines = [line.rstrip("\n") for line in sys.stdin if line.strip() != ""]
    path = []
    dir_sum = {}  # key: tuple(path_prefix), value: total size

    def add_size(sz):
        # add to all ancestors including current directory
        for k in range(len(path) + 1):
            key = tuple(path[:k])
            dir_sum[key] = dir_sum.get(key, 0) + sz

    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("$"):
            parts = line.split()
            if parts[1] == "cd":
                arg = parts[2]
                if arg == "/":
                    path = []
                elif arg == "..":
                    if path:
                        path.pop()
                else:
                    path.append(arg)
            # "$ ls" has no direct action; next lines are handled by else
            i += 1
        else:
            a, b = line.split(maxsplit=1)
            if a != "dir":
                add_size(int(a))
            i += 1

    used = dir_sum.get((), 0)
    total_disk = 70000000
    need_free = 30000000
    current_free = total_disk - used
    required = need_free - current_free
    if required <= 0:
        required = 0

    ans = None
    for sz in dir_sum.values():
        if sz >= required and (ans is None or sz < ans):
            ans = sz

    print(ans if ans is not None else 0)

if __name__ == "__main__":
    solve()

DEBUGGING INVOKED: 0

PLANNING VERIFICATION SUMMARY (3 checks; conf 96/95/96):
